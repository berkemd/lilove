{
  "cli": {
    "version": ">=12.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "20.12.2",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:5000"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lilove.org"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lilove.org",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "889526589579-gvuj12sul4hnb3sjbop2lhbd1bhfb6o3.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "889526589579-gvuj12sul4hnb3sjbop2lhbd1bhfb6o3.apps.googleusercontent.com",
        "SENTRY_DSN": "${SENTRY_DSN}"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "brkekahraman@icloud.com",
        "ascAppId": "6753267087",
        "appleTeamId": "87U9ZK37M2"
      }
    }
  }
}
