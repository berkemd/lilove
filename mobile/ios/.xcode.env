# Xcode starts script phases separately from ci_post_clone.
# Expo 52 accepts lowercase booleans; Xcode Cloud supplies CI=TRUE.
case "${CI:-}" in
TRUE) export CI=true ;;
FALSE) export CI=false ;;
esac
export NODE_BINARY="$(command -v node)"
if [ "${CONFIGURATION:-}" = Release ]; then
  . "${PODS_ROOT:-$PROJECT_DIR/Pods}/../ci_scripts/release-env.sh"
fi
