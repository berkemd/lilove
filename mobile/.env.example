# LiLove Mobile App - Environment Variables Template
# This file is for reference only - actual secrets are stored in EAS Secrets

# Production API URL
EXPO_PUBLIC_API_URL=https://lilove.org

# Development API URL (local testing)
# EXPO_PUBLIC_API_URL=http://localhost:5000

# RevenueCat API Keys (stored in EAS Secrets)
# Add these via: eas secret:create --scope project --name REVENUECAT_IOS_API_KEY --value your_key
REVENUECAT_IOS_API_KEY=your_revenuecat_ios_api_key
REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_api_key

# Apple App Store Connect (for EAS build)
# Add these via: eas secret:create
APPLE_APP_STORE_CONNECT_ISSUER_ID=your_issuer_id
APPLE_APP_STORE_CONNECT_KEY_ID=your_key_id
APPLE_APP_STORE_CONNECT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour key\n-----END PRIVATE KEY-----

# Build configuration
EXPO_NO_CAPABILITY_SYNC=1
