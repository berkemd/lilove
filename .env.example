# ===== APPLICATION SETTINGS =====
NODE_ENV=development
APP_URL=http://localhost:5000

# ===== DATABASE CONFIGURATION =====
# PostgreSQL database connection (auto-configured by Replit)
DATABASE_URL=

# ===== AUTHENTICATION =====
# Replit Auth (auto-configured)
REPLIT_DB_URL=

# ===== PAYMENT PROVIDERS =====

# Paddle Payment Provider
# Get your keys from: https://vendors.paddle.com/authentication
# For testing, use Paddle Sandbox: https://sandbox-vendors.paddle.com
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_CLIENT_TOKEN=your_paddle_client_token_here

# SECURITY: Paddle Webhook Secret (REQUIRED for webhook security)
# Get this from: Paddle Dashboard > Developer Tools > Notifications > Webhook Secret
# This is used to verify HMAC-SHA256 signatures on incoming webhooks
# Without this, webhooks will be rejected for security
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here

# Paddle Product Price IDs
# Configure these in your Paddle dashboard under Products & Prices
# Pro Plan - $19.99/month or $199.99/year (save ~16.67%)
PADDLE_PRO_MONTHLY_PRICE_ID=pri_01xxxxxxxxxxxxxxxxxxxxx
PADDLE_PRO_YEARLY_PRICE_ID=pri_01xxxxxxxxxxxxxxxxxxxxx

# Team Plan - $99.99/month or $999/year (save ~16.67%)
PADDLE_TEAM_MONTHLY_PRICE_ID=pri_01xxxxxxxxxxxxxxxxxxxxx
PADDLE_TEAM_YEARLY_PRICE_ID=pri_01xxxxxxxxxxxxxxxxxxxxx

# Stripe Payment Provider (Legacy - Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=

# PayGate.to (Crypto Payments - Optional)
PAYGATE_USDC_WALLET=

# ===== AI & ANALYTICS =====

# OpenAI API Key for AI features
OPENAI_API_KEY=

# PostHog Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ===== OAUTH PROVIDERS (Optional) =====
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# SECURITY: Apple App Store Server API (REQUIRED for IAP webhook security)
# Get these from: Apple Developer > Keys > Create App Store Connect API Key
# The private key is used to verify JWT signatures on App Store webhooks
APPSTORE_ISSUER_ID=your_appstore_issuer_id_here
APPSTORE_KEY_ID=your_appstore_key_id_here
APPSTORE_PRIVATE_KEY_PEM=your_appstore_private_key_pem_here
APPSTORE_BUNDLE_ID=org.lilove.app

# ===== EMAIL & NOTIFICATIONS =====
# Email service configuration (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Web Push Notifications (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ===== SESSION & SECURITY =====
SESSION_SECRET=your_random_session_secret_here
JWT_SECRET=your_jwt_secret_here

# ===== MOBILE IAP (RevenueCat) =====
# Get these from: https://app.revenuecat.com/settings/public-api-keys
# These are stored in EAS Secrets for mobile builds
REVENUECAT_IOS_API_KEY=your_revenuecat_ios_api_key
REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_api_key

# ===== COIN PACKAGES (Paddle Price IDs) =====
# One-time coin purchases via Paddle
PADDLE_COINS_STARTER_PRICE_ID=pri_01xxxxxxxxxxxxxxxxxxxxx
PADDLE_COINS_VALUE_PRICE_ID=pri_01xxxxxxxxxxxxxxxxxxxxx
PADDLE_COINS_POWER_PRICE_ID=pri_01xxxxxxxxxxxxxxxxxxxxx
PADDLE_COINS_ULTIMATE_PRICE_ID=pri_01xxxxxxxxxxxxxxxxxxxxx

# ===== TESTING =====
# Use this for Paddle sandbox testing
# Paddle Sandbox Test Cards:
# - Successful payment: 4242 4242 4242 4242
# - Declined payment: 4000 0000 0000 0002
# - Authentication required: 4000 0025 0000 3155
# 
# To switch between sandbox and production:
# - Development (NODE_ENV=development): Uses Paddle Sandbox
# - Production (NODE_ENV=production): Uses Paddle Production
# 
# Webhook Testing URL (for local development):
# Use ngrok or similar to expose localhost: https://your-ngrok-url.ngrok.io/api/webhooks/paddle
